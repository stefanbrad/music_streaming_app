@model IEnumerable<Offstream.web.Models.Playlist>
@{
    ViewData["Title"] = "My Playlists";
    var sortBy = ViewBag.SortBy as string ?? "recent";
    var savedPlaylists = ViewBag.SavedPlaylists as IEnumerable<Offstream.web.Models.Playlist> ?? new List<Offstream.web.Models.Playlist>();
    var publicPlaylists = ViewBag.PublicPlaylists as IEnumerable<Offstream.web.Models.Playlist> ?? new List<Offstream.web.Models.Playlist>();
}

<div class="container py-4">
    <!-- Header & Playlist Creation Form -->
    <div class="card glass-card border-0 p-4 mb-4">
        <div class="row align-items-center g-4">
            <div class="col-12 col-md-5 text-start">
                <span class="badge bg-secondary mb-1">COLLECTIONS</span>
                <h2 class="fw-bold text-white mb-1">My Playlists</h2>
                <p class="text-muted mb-0 font-body" style="font-size: 0.9rem;">Organize and share your favorite music tracks.</p>
            </div>
            
            <div class="col-12 col-md-7">
                <form asp-controller="Playlist" asp-action="Create" method="post" class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
                    <input type="text" name="name" class="form-control" placeholder="New playlist name..." required style="max-width: 320px;" />
                    
                    <div class="form-check form-switch ms-sm-2 text-nowrap my-2 my-sm-0">
                        <input class="form-check-input" type="checkbox" name="isShared" value="true" id="isSharedSwitch">
                        <label class="form-check-label text-muted" for="isSharedSwitch" style="font-size: 0.95rem;">Public</label>
                    </div>
                    
                    <button type="submit" class="btn btn-primary text-nowrap ms-sm-2">
                        <i class="bi bi-plus-circle-fill me-1"></i> Create
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="card glass-card border-0 mb-4">
        <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <!-- Client-side search input -->
            <div class="search-container">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="searchInput" class="search-input" placeholder="Search playlist name...">
            </div>

            <!-- Sorting Buttons -->
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted text-nowrap me-2" style="font-size: 0.9rem;">Sort by:</span>
                <a href="/Playlist?sortBy=recent" class="btn btn-sm rounded-pill px-3 @(sortBy == "recent" ? "btn-primary" : "btn-secondary")">
                    Recently Created
                </a>
                <a href="/Playlist?sortBy=alpha" class="btn btn-sm rounded-pill px-3 @(sortBy == "alpha" ? "btn-primary" : "btn-secondary")">
                    Alphabetical
                </a>
            </div>
        </div>
    </div>

    <!-- Tabs Navigation -->
    <ul class="nav nav-pills nav-fill mb-4 p-1 glass-card border-0 rounded-pill" id="playlistTabs" role="tablist" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--glass-border) !important;">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill fw-bold py-2 text-white" id="my-collections-tab" data-bs-toggle="pill" data-bs-target="#my-collections" type="button" role="tab" aria-controls="my-collections" aria-selected="true">
                <i class="bi bi-collection-play me-2"></i>My Collections
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold py-2 text-white" id="saved-playlists-tab" data-bs-toggle="pill" data-bs-target="#saved-playlists" type="button" role="tab" aria-controls="saved-playlists" aria-selected="false">
                <i class="bi bi-bookmark-heart me-2"></i>Saved Playlists (@savedPlaylists.Count())
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill fw-bold py-2 text-white" id="explore-playlists-tab" data-bs-toggle="pill" data-bs-target="#explore-playlists" type="button" role="tab" aria-controls="explore-playlists" aria-selected="false">
                <i class="bi bi-compass me-2"></i>Explore Public (@publicPlaylists.Count())
            </button>
        </li>
    </ul>

    <!-- Grids of Playlists inside Tab Content -->
    <div class="tab-content" id="playlistTabsContent">
        <!-- TAB 1: My Collections -->
        <div class="tab-pane fade show active" id="my-collections" role="tabpanel" aria-labelledby="my-collections-tab">
            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    var colors = new[] { 
                        "linear-gradient(135deg, #6366f1 0%, #ec4899 100%)", 
                        "linear-gradient(135deg, #10b981 0%, #3b82f6 100%)", 
                        "linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)",
                        "linear-gradient(135deg, #8b5cf6 0%, #d946ef 100%)"
                    };
                    var colorIdx = 0;

                    foreach (var playlist in Model)
                    {
                        var gradient = colors[colorIdx % colors.Length];
                        colorIdx++;

                        <div class="col-12 col-md-6 col-lg-4 playlist-card-col">
                            <div class="card glass-card border-0 h-100 shadow-sm transition">
                                <!-- Playlist Gradient Art Banner -->
                                <div style="height: 120px; background: @gradient; border-top-left-radius: 16px; border-top-right-radius: 16px; display: flex; align-items: flex-end; padding: 16px; position: relative;">
                                    <span class="badge @(playlist.IsShared ? "bg-success" : "bg-secondary") position-absolute" style="top: 16px; right: 16px;">
                                        @(playlist.IsShared ? "Public" : "Private")
                                    </span>
                                    <div class="player-song-art shadow-lg bg-dark" style="margin-bottom: -32px; border: 3px solid var(--bg-secondary); overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                        @if (!string.IsNullOrEmpty(playlist.CoverPath))
                                        {
                                            <img src="@playlist.CoverPath" alt="Cover" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-music-note-list text-indigo"></i>
                                        }
                                    </div>
                                </div>

                                <!-- Playlist Body Details -->
                                <div class="card-body p-4 pt-5 d-flex flex-column justify-content-between">
                                    <div>
                                        <h4 class="fw-bold text-white text-truncate playlist-name-text mb-1">@playlist.Name</h4>
                                        <p class="text-muted small mb-4">
                                            <i class="bi bi-person-fill me-1"></i> Owner: You
                                        </p>
                                    </div>
                                    
                                    <div class="d-flex gap-2 align-items-center mt-3">
                                        <!-- Open details button -->
                                        <a asp-action="Details" asp-route-id="@playlist.Id" class="btn btn-outline-primary rounded-pill flex-grow-1">
                                            Open Playlist
                                        </a>

                                        <!-- Delete playlist button -->
                                        <form asp-action="Delete" asp-route-id="@playlist.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this playlist? All contents will be unlinked.');" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger rounded-pill px-3" title="Delete playlist">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-folder-plus text-muted fs-1 mb-3 d-block"></i>
                        <h5 class="text-muted">You haven't created any playlists yet.</h5>
                        <p class="text-muted small">Use the input form above to create your first collection.</p>
                    </div>
                }
            </div>
        </div>

        <!-- TAB 2: Saved Playlists -->
        <div class="tab-pane fade" id="saved-playlists" role="tabpanel" aria-labelledby="saved-playlists-tab">
            <div class="row g-4">
                @if (savedPlaylists.Any())
                {
                    var colors = new[] { 
                        "linear-gradient(135deg, #8b5cf6 0%, #d946ef 100%)",
                        "linear-gradient(135deg, #10b981 0%, #3b82f6 100%)", 
                        "linear-gradient(135deg, #6366f1 0%, #ec4899 100%)", 
                        "linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)"
                    };
                    var colorIdx = 0;

                    foreach (var playlist in savedPlaylists)
                    {
                        var gradient = colors[colorIdx % colors.Length];
                        colorIdx++;

                        <div class="col-12 col-md-6 col-lg-4 playlist-card-col">
                            <div class="card glass-card border-0 h-100 shadow-sm transition">
                                <!-- Playlist Gradient Art Banner -->
                                <div style="height: 120px; background: @gradient; border-top-left-radius: 16px; border-top-right-radius: 16px; display: flex; align-items: flex-end; padding: 16px; position: relative;">
                                    <span class="badge bg-success position-absolute" style="top: 16px; right: 16px;">Public</span>
                                    <div class="player-song-art shadow-lg bg-dark" style="margin-bottom: -32px; border: 3px solid var(--bg-secondary); overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                        @if (!string.IsNullOrEmpty(playlist.CoverPath))
                                        {
                                            <img src="@playlist.CoverPath" alt="Cover" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-music-note-list text-indigo"></i>
                                        }
                                    </div>
                                </div>

                                <!-- Playlist Body Details -->
                                <div class="card-body p-4 pt-5 d-flex flex-column justify-content-between">
                                    <div>
                                        <h4 class="fw-bold text-white text-truncate playlist-name-text mb-1">@playlist.Name</h4>
                                        <p class="text-muted small mb-4">
                                            <i class="bi bi-person-circle me-1"></i> Creator: @playlist.User?.Username
                                        </p>
                                    </div>
                                    
                                    <div class="d-flex gap-2 align-items-center mt-3">
                                        <!-- Open details button -->
                                        <a asp-action="Details" asp-route-id="@playlist.Id" class="btn btn-outline-primary rounded-pill flex-grow-1">
                                            Open Playlist
                                        </a>

                                        <!-- Unsave playlist button -->
                                        <form asp-action="Unsave" method="post" onsubmit="return confirm('Remove this playlist from your library?');" class="d-inline">
                                            <input type="hidden" name="playlistId" value="@playlist.Id" />
                                            <button type="submit" class="btn btn-outline-danger rounded-pill px-3" title="Unsave playlist">
                                                <i class="bi bi-bookmark-dash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-bookmark text-muted fs-1 mb-3 d-block"></i>
                        <h5 class="text-muted">No saved playlists.</h5>
                        <p class="text-muted small">Discover public playlists shared by other users under the Explore tab.</p>
                    </div>
                }
            </div>
        </div>

        <!-- TAB 3: Explore Playlists -->
        <div class="tab-pane fade" id="explore-playlists" role="tabpanel" aria-labelledby="explore-playlists-tab">
            <div class="row g-4">
                @if (publicPlaylists.Any())
                {
                    var colors = new[] { 
                        "linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)",
                        "linear-gradient(135deg, #8b5cf6 0%, #d946ef 100%)",
                        "linear-gradient(135deg, #10b981 0%, #3b82f6 100%)", 
                        "linear-gradient(135deg, #6366f1 0%, #ec4899 100%)"
                    };
                    var colorIdx = 0;

                    foreach (var playlist in publicPlaylists)
                    {
                        var gradient = colors[colorIdx % colors.Length];
                        colorIdx++;
                        
                        bool alreadySaved = savedPlaylists.Any(sp => sp.Id == playlist.Id);

                        <div class="col-12 col-md-6 col-lg-4 playlist-card-col">
                            <div class="card glass-card border-0 h-100 shadow-sm transition">
                                <!-- Playlist Gradient Art Banner -->
                                <div style="height: 120px; background: @gradient; border-top-left-radius: 16px; border-top-right-radius: 16px; display: flex; align-items: flex-end; padding: 16px; position: relative;">
                                    <span class="badge bg-success position-absolute" style="top: 16px; right: 16px;">Public</span>
                                    <div class="player-song-art shadow-lg bg-dark" style="margin-bottom: -32px; border: 3px solid var(--bg-secondary); overflow: hidden; display: flex; align-items: center; justify-content: center;">
                                        @if (!string.IsNullOrEmpty(playlist.CoverPath))
                                        {
                                            <img src="@playlist.CoverPath" alt="Cover" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-music-note-list text-indigo"></i>
                                        }
                                    </div>
                                </div>

                                <!-- Playlist Body Details -->
                                <div class="card-body p-4 pt-5 d-flex flex-column justify-content-between">
                                    <div>
                                        <h4 class="fw-bold text-white text-truncate playlist-name-text mb-1">@playlist.Name</h4>
                                        <p class="text-muted small mb-4">
                                            <i class="bi bi-person-circle me-1"></i> Creator: @playlist.User?.Username
                                        </p>
                                    </div>
                                    
                                    <div class="d-flex gap-2 align-items-center mt-3">
                                        <!-- Open details button -->
                                        <a asp-action="Details" asp-route-id="@playlist.Id" class="btn btn-outline-primary rounded-pill flex-grow-1">
                                            Open Playlist
                                        </a>

                                        <!-- Save/Unsave playlist toggle button -->
                                        @if (alreadySaved)
                                        {
                                            <form asp-action="Unsave" method="post" class="d-inline">
                                                <input type="hidden" name="playlistId" value="@playlist.Id" />
                                                <button type="submit" class="btn btn-primary rounded-pill px-3" title="Saved to Library">
                                                    <i class="bi bi-bookmark-fill"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Save" method="post" class="d-inline">
                                                <input type="hidden" name="playlistId" value="@playlist.Id" />
                                                <button type="submit" class="btn btn-outline-primary rounded-pill px-3" title="Save to Library">
                                                    <i class="bi bi-bookmark"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-compass text-muted fs-1 mb-3 d-block"></i>
                        <h5 class="text-muted">No public playlists found.</h5>
                        <p class="text-muted small">When other users share their playlists publicly, they'll show up here.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>