@model Offstream.web.Models.Playlist
@{
    ViewData["Title"] = Model.Name + " - Playlist";
    var playlistSongs = ViewBag.PlaylistSongs as IEnumerable<Offstream.web.Models.PlaylistSong> ?? new List<Offstream.web.Models.PlaylistSong>();
    var sortBy = ViewBag.SortBy as string ?? "recent";
    var isOwner = ViewBag.IsOwner as bool? ?? false;
    var isSaved = ViewBag.IsSaved as bool? ?? false;
}

<div class="container py-4">
    <!-- Back Navigation -->
    <div class="mb-3">
        <a asp-action="Index" class="text-decoration-none text-muted" style="font-size: 0.9rem;">
            <i class="bi bi-arrow-left me-1"></i> Back to Playlists
        </a>
    </div>

    <!-- Playlist Header Banner -->
    <div class="card glass-card border-0 p-4 mb-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-4">
            <div class="d-flex align-items-center gap-3">
                <div class="player-song-art shadow-lg bg-indigo text-center" style="width: 72px; height: 72px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                    @if (!string.IsNullOrEmpty(Model.CoverPath))
                    {
                        <img src="@Model.CoverPath" alt="Cover" style="width: 100%; height: 100%; object-fit: cover;" />
                    }
                    else
                    {
                        <i class="bi bi-music-note-list text-white fs-2"></i>
                    }
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary">PLAYLIST</span>
                        <span class="badge @(Model.IsShared ? "bg-success" : "bg-secondary")">
                            @(Model.IsShared ? "Public" : "Private")
                        </span>
                    </div>
                    <h2 class="fw-bold text-white mb-0 mt-1">@Model.Name</h2>
                    <p class="text-muted small mb-0 mt-1">
                        Created by @(isOwner ? "You" : Model.User?.Username) &bull; @playlistSongs.Count() tracks
                    </p>
                </div>
            </div>

            <!-- Play & Sort Controls -->
            <div class="d-flex align-items-center gap-2">
                @if (playlistSongs.Any())
                {
                    <button class="btn btn-primary rounded-pill px-4 shadow" onclick="playWholePlaylist()">
                        <i class="bi bi-play-fill me-1"></i> Play Playlist
                    </button>
                }
                @if (isOwner)
                {
                    <button class="btn btn-outline-secondary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#editPlaylistModal">
                        <i class="bi bi-pencil-fill me-1"></i> Edit Details
                    </button>
                }
                else
                {
                    @if (isSaved)
                    {
                        <form asp-action="Unsave" method="post" class="d-inline">
                            <input type="hidden" name="playlistId" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                                <i class="bi bi-bookmark-dash-fill me-1"></i> Unsave Playlist
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Save" method="post" class="d-inline">
                            <input type="hidden" name="playlistId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                <i class="bi bi-bookmark-plus-fill me-1"></i> Save to Library
                            </button>
                        </form>
                    }

                    <form asp-action="Clone" method="post" class="d-inline">
                        <input type="hidden" name="playlistId" value="@Model.Id" />
                        <button type="submit" class="btn btn-outline-primary rounded-pill px-4">
                            <i class="bi bi-files me-1"></i> Copy to My Playlists
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>

    <!-- Edit Playlist Modal -->
    @if (isOwner)
    {
        <div class="modal fade" id="editPlaylistModal" tabindex="-1" aria-labelledby="editPlaylistModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content glass-card" style="background: rgba(17, 24, 39, 0.95); border: 1px solid var(--glass-border); border-radius: 20px;">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-white" id="editPlaylistModalLabel">Edit Playlist Details</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-shadow="none" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <div class="modal-body py-4">
                            <input type="hidden" name="id" value="@Model.Id" />
                            
                            <div class="mb-3">
                                <label class="form-label">Playlist Name</label>
                                <input type="text" name="name" class="form-control" value="@Model.Name" required placeholder="My Awesome Playlist" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label">Cover Image (.png, .jpg, .jpeg)</label>
                                <input type="file" name="coverFile" class="form-control" accept="image/png, image/jpeg, image/jpg" id="coverFileInput" />
                                <div class="form-text text-muted">Upload an image to represent your playlist. Leave empty to keep the current one.</div>
                            </div>

                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" name="isShared" value="true" id="editIsSharedSwitch" @(Model.IsShared ? "checked" : "")>
                                <label class="form-check-label text-white" for="editIsSharedSwitch">Make Playlist Public (Shared)</label>
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Quick Add Song Form (Only for Playlist Owner) -->
    @if (isOwner && ViewBag.UserSongs != null)
    {
        var userSongs = ViewBag.UserSongs as IEnumerable<Offstream.web.Models.Song> ?? new List<Offstream.web.Models.Song>();
        <div class="card glass-card border-0 p-4 mb-4">
            <h5 class="text-white fw-bold mb-3" style="font-size: 1.05rem;">
                <i class="bi bi-plus-circle-fill text-indigo me-2"></i>Add Track to Playlist
            </h5>
            
            <form asp-action="AddSong" method="post" class="d-flex flex-column flex-sm-row gap-2">
                <input type="hidden" name="playlistId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="/Playlist/Details/@Model.Id?sortBy=@sortBy" />
                
                <select name="songId" class="form-control flex-grow-1" required>
                    <option value="" disabled selected>Select a song from your library...</option>
                    @foreach (var song in userSongs)
                    {
                        // Check if song is already in the playlist to highlight or filter
                        bool exists = playlistSongs.Any(ps => ps.SongId == song.Id);
                        if (!exists)
                        {
                            <option value="@song.Id">@song.Title - @song.Artist</option>
                        }
                    }
                </select>
                
                <button type="submit" class="btn btn-primary text-nowrap">
                    <i class="bi bi-plus-lg"></i> Add Song
                </button>
            </form>
        </div>
    }

    <!-- Search & Filter Area -->
    <div class="card glass-card border-0 mb-4">
        <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <!-- Search bar -->
            <div class="search-container">
                <i class="bi bi-search search-icon"></i>
                <input type="text" id="searchInput" class="search-input" placeholder="Search playlist tracks...">
            </div>

            <!-- Sort parameters -->
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted text-nowrap me-2" style="font-size: 0.9rem;">Sort by:</span>
                <a href="/Playlist/Details/@Model.Id?sortBy=recent" class="btn btn-sm rounded-pill px-3 @(sortBy == "recent" ? "btn-primary" : "btn-secondary")">
                    Recently Added
                </a>
                <a href="/Playlist/Details/@Model.Id?sortBy=alpha" class="btn btn-sm rounded-pill px-3 @(sortBy == "alpha" ? "btn-primary" : "btn-secondary")">
                    Alphabetical
                </a>
            </div>
        </div>
    </div>

    <!-- Song List -->
    @if (!playlistSongs.Any())
    {
        <div class="card glass-card border-0 p-5 text-center">
            <div class="card-body">
                <i class="bi bi-music-note text-muted fs-1 mb-3 d-block"></i>
                <h5 class="text-white mb-2">This playlist is empty</h5>
                <p class="text-muted small">Add tracks to start listening.</p>
            </div>
        </div>
    }
    else
    {
        var index = 1;
        <div class="song-list-container">
            @foreach (var ps in playlistSongs)
            {
                <div class="song-item glass-card border-0" data-song-id="@ps.Song.Id">
                    <div class="song-index">@index</div>
                    
                    <div class="song-cover-placeholder">
                        <i class="bi bi-music-note-beamed text-indigo"></i>
                    </div>

                    <div class="song-info">
                        <div class="song-title">@ps.Song.Title</div>
                        <div class="song-artist">@ps.Song.Artist</div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <!-- Individual play button -->
                        <button class="btn btn-outline-primary rounded-pill play-state-indicator p-0 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" onclick="window.AudioPlayer.play(@ps.Song.Id)" title="Play track">
                            <i class="bi bi-play-fill text-white fs-5"></i>
                        </button>
                        
                        <!-- Remove button (Only if user owns playlist) -->
                        @if (isOwner)
                        {
                            <form asp-action="RemoveSong" method="post" onsubmit="return confirm('Remove track from playlist?');">
                                <input type="hidden" name="playlistId" value="@Model.Id" />
                                <input type="hidden" name="songId" value="@ps.Song.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill p-0 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" title="Remove track">
                                    <i class="bi bi-dash-lg"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
                index++;
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        // Track list variable
        window.playlistTracksList = [
            @foreach (var ps in playlistSongs)
            {
                @:{ id: @ps.Song.Id, title: "@Html.Raw(ps.Song.Title?.Replace("\"", "\\\"") ?? "")", artist: "@Html.Raw((ps.Song.Artist ?? "Unknown").Replace("\"", "\\\""))", url: "/Audio/Stream/@ps.Song.Id" },
            }
        ];

        // Set queue in global player
        window.AudioPlayer.setQueue(window.playlistTracksList);

        // Trigger playing the whole playlist from the beginning
        window.playWholePlaylist = function() {
            if (window.playlistTracksList && window.playlistTracksList.length > 0) {
                window.AudioPlayer.play(window.playlistTracksList[0].id);
            }
        };
    </script>
}
