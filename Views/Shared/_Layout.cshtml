<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Offstream</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <!-- Custom styling -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Glass Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <img src="/images/logo.png" alt="Offstream Logo" style="height: 38px; width: auto; margin-right: 10px; object-fit: contain;" /> Offstream
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Library" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Library" asp-action="Index">
                                <i class="bi bi-music-note-list me-1"></i> My Library
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Library" && ViewContext.RouteData.Values["action"]?.ToString() == "Upload" ? "active" : "")" asp-controller="Library" asp-action="Upload">
                                <i class="bi bi-cloud-arrow-up me-1"></i> Upload
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Playlist" ? "active" : "")" asp-controller="Playlist" asp-action="Index">
                                <i class="bi bi-folder-symlink me-1"></i> Playlists
                            </a>
                        </li>
                        <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-box-arrow-right"></i> Log out
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Log in
                            </a>
                        </li>
                        <li class="nav-item ms-lg-2">
                            <a class="btn btn-primary btn-sm px-3" asp-controller="Account" asp-action="Register">
                                Sign up
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Hidden Core Player Element -->
    @if (User.Identity?.IsAuthenticated == true)
    {
        <audio id="globalPlayer"></audio>

        <!-- Floating Premium Music Player Bar -->
        <div class="floating-player d-flex align-items-center">
            <!-- Left Panel: Song Info -->
            <div class="player-left-panel d-flex align-items-center me-auto">
                <div class="player-song-art" id="playerArt">
                    <i class="bi bi-music-note text-white fs-5"></i>
                </div>
                <div class="ms-3 d-flex flex-column justify-content-center player-song-info">
                    <span class="text-white fw-bold text-truncate" id="playerTrackTitle">No track active</span>
                    <span class="text-muted text-truncate" id="playerTrackArtist">Select a song to stream</span>
                </div>
            </div>

            <!-- Center Panel: Custom Player Controls -->
            <div class="custom-player-controls">
                <div class="player-buttons">
                    <button class="player-btn" id="playerBtnPrev" title="Previous track">
                        <i class="bi bi-skip-start-fill"></i>
                    </button>
                    <button class="player-btn play-toggle" id="playerBtnPlay" title="Play">
                        <i class="bi bi-play-fill" id="playIcon"></i>
                    </button>
                    <button class="player-btn" id="playerBtnNext" title="Next track">
                        <i class="bi bi-skip-end-fill"></i>
                    </button>
                </div>
                <div class="player-slider-container">
                    <span class="player-time" id="playerTimeCurrent">0:00</span>
                    <input type="range" class="player-slider" id="playerProgressBar" min="0" max="100" value="0">
                    <span class="player-time" id="playerTimeTotal">0:00</span>
                </div>
            </div>

            <!-- Right Panel: Volume Panel -->
            <div class="player-volume-container d-flex align-items-center ms-auto">
                <button class="player-btn" id="playerBtnMute" title="Mute/Unmute" style="width: 32px; height: 32px;">
                    <i class="bi bi-volume-up-fill" id="muteIcon"></i>
                </button>
                <input type="range" class="player-slider" id="playerVolumeSlider" min="0" max="100" value="80" style="max-width: 100px;">
            </div>
        </div>
    }

    <!-- Scripts Bootstrap & Core -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>