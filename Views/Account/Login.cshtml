@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-6 col-lg-5">
        <div class="card glass-form-card border-0">
            <div class="text-center mb-4">
                <div class="player-song-art mx-auto mb-3 music-disc-spin" style="width: 56px; height: 56px; border-radius: 50%;">
                    <i class="bi bi-activity text-white fs-4"></i>
                </div>
                <h3 class="fw-bold text-white mb-1">Sign In</h3>
                <p class="text-muted small">Enter your credentials to stream your audio library.</p>
            </div>

            <form asp-controller="Account" asp-action="Login" method="post">
                
                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 text-center py-2 mb-3" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border-radius: 12px; font-size: 0.9rem;"></div>

                
                <div class="mb-3">
                    <label class="form-label">Username</label>
                    <div class="position-relative">
                        <input type="text" name="username" class="form-control" placeholder="Your username" required style="padding-left: 2.5rem;" />
                        <i class="bi bi-person position-absolute text-muted" style="left: 14px; top: 50%; transform: translateY(-50%);"></i>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <div class="position-relative">
                        <input type="password" name="password" class="form-control" placeholder="••••••••" required style="padding-left: 2.5rem;" />
                        <i class="bi bi-lock position-absolute text-muted" style="left: 14px; top: 50%; transform: translateY(-50%);"></i>
                    </div>
                </div>
                
                <div class="mb-4 form-check text-start">
                    <input type="checkbox" name="rememberMe" value="true" class="form-check-input" id="rememberMe">
                    <label class="form-check-label text-muted small" for="rememberMe" style="cursor: pointer;">Stay logged in on this device</label>
                </div>
                
                <!-- Submit -->
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            </form>
            
            <div class="text-center mt-4">
                <span class="text-muted small">New to Offstream?</span>
                <a asp-action="Register" class="text-indigo text-decoration-none fw-semibold small ms-1">Create an account</a>
            </div>
        </div>
    </div>
</div>